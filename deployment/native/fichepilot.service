[Unit]
Description=FichePilot API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fichepilot
Group=fichepilot
WorkingDirectory=/opt/fichepilot/current
EnvironmentFile=/etc/fichepilot/fichepilot.env
ExecStart=/usr/bin/node backend/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fichepilot/files /var/lib/fichepilot/tmp
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
