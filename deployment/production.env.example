# A copier vers .env.production à la racine du dépôt, jamais à versionner.
# Modèle volontairement NON fonctionnel avant substitution des placeholders.
APP_DOMAIN=app.fichepilot.fr
ACME_EMAIL=REPLACE_WITH_REAL_EMAIL

NODE_ENV=production
PORT=5000
CLIENT_URL=https://app.fichepilot.fr
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/fichepilot_beta?retryWrites=true&w=majority

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_MINIMUM_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_ISSUER=saas-core-api
JWT_ACCESS_AUDIENCE=saas-core-api
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=15
WORKSPACE_OWNERSHIP_TRANSFER_AUTHORIZATION_TTL_HOURS=24
TRIAL_IDENTITY_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_MINIMUM_32_CHARACTERS

# Brevo : LOGIN SMTP et CLE SMTP (pas la clé API).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
# Adresse proposée, à authentifier auprès de Brevo après achat du domaine.
SMTP_FROM_EMAIL=notifications@fichepilot.fr
SMTP_FROM_NAME=FichePilot

UPLOAD_MAX_FILE_SIZE_BYTES=5242880
FILE_RETENTION_DAYS=30
FILE_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT_DIR=/var/lib/fichepilot/files
UPLOAD_TEMP_DIR=/var/lib/fichepilot/tmp
CLAMAV_BINARY_PATH=clamscan
CLAMAV_SCAN_TIMEOUT_MS=30000
UPLOAD_TEMP_FILE_MAX_AGE_MINUTES=60
E2E_BYPASS_RATE_LIMITS=false
ALLOW_DEVELOPMENT_DATA_RESET=false
