NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/saas-core-api?replicaSet=rs0
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_ISSUER=saas-core-api
JWT_ACCESS_AUDIENCE=saas-core-api

REFRESH_TOKEN_EXPIRES_IN_DAYS=7

PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=15

# Fenêtre maximale pendant laquelle un owner peut utiliser une autorisation
# exceptionnelle de transfert de propriété accordée par un Super administrateur.
# Valeur entière en heures, comprise entre 1 et 24.
WORKSPACE_OWNERSHIP_TRANSFER_AUTHORIZATION_TTL_HOURS=24

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=SAAS Core

UPLOAD_MAX_FILE_SIZE_BYTES=5242880
FILE_RETENTION_DAYS=30

FILE_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT_DIR=uploads/files
UPLOAD_TEMP_DIR=uploads/tmp

# Chemin vers l'exécutable ClamAV.
# En production Linux, "clamscan" peut suffire s'il est disponible dans le PATH.
CLAMAV_BINARY_PATH=clamscan

# Durée maximale autorisée pour une analyse antivirus, en millisecondes.
CLAMAV_SCAN_TIMEOUT_MS=30000

# Un temporaire n'est purgeable qu'après cette durée.
UPLOAD_TEMP_FILE_MAX_AGE_MINUTES=60

# Secret dédié à la génération des empreintes HMAC utilisées pour
# identifier durablement une identité ayant déjà consommé un trial.
TRIAL_IDENTITY_SECRET=replace_with_a_dedicated_long_random_secret

# Désactive par défaut le bypass des rate limits. Cette capacité est réservée
# au runtime Playwright E2E et n'est acceptée que lorsque NODE_ENV=test et que
# MONGODB_URI cible explicitement une base se terminant par _e2e_test.
E2E_BYPASS_RATE_LIMITS=false

# Autorise explicitement les commandes qui détruisent des données de test en
# environnement development. Laisser false tant qu'un reset n'est pas nécessaire.
# Cette valeur est refusée lorsque NODE_ENV=production.
ALLOW_DEVELOPMENT_DATA_RESET=false

# Variables utilisées uniquement par `npm run seed:super-admin`.
# Elles ne sont pas requises pour démarrer l'API HTTP.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_seed_password
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
